# Copy to .env (never commit .env). Every variable is optional for local development:
# the defaults below match docker-compose.yml and application.yml.

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (dev defaults shown). Either set DB_URL directly, or the individual parts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bugthrive_labs
DB_USERNAME=bugthrive
DB_PASSWORD=bugthrive
# DB_URL=jdbc:postgresql://localhost:5432/bugthrive_labs
# DB_POOL_SIZE=10

# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Authentication (Phase 2A) ---
# HMAC-SHA256 signing secret, at least 32 bytes. REQUIRED in prod; dev has a local-only default.
# Generate one with:  openssl rand -base64 48
# JWT_SECRET=
# Access-token lifetime (ISO-8601 duration)
JWT_EXPIRATION=PT1H

# Optional bootstrap admin, created on startup if it doesn't exist (registration only creates students)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
